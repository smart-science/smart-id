{
    "name": "@smart-science/sid",
    "version": "0.1.0",
    "description": "SID: generator, parser, formatter, and checksum verifier",
    "keywords": [
        "sid",
        "smart-id",
        "smartid",
        "crockford",
        "checksum",
        "generator",
        "parser",
        "formatter",
        "verifier"
    ],
    "author": "Martin Winkler",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smart-science/smart-id.git"
    },
    "bugs": {
        "url": "https://github.com/smart-science/smart-id/issues"
    },
    "homepage": "https://github.com/smart-science/smart-id#readme",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0",
        "bun": ">=1.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "bun run build:types && bun run build:js",
        "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --minify",
        "build:types": "tsc --emitDeclarationOnly",
        "test": "bun test && bun run test:types",
        "test:types": "tsc --noEmit -p tsconfig.test.json",
        "coverage": "bun test --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "biome": "biome check --write .",
        "prepublishOnly": "bun run build && bun test"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "@types/bun": "^1.4.0",
        "typescript": "^5.9.3"
    }
}
